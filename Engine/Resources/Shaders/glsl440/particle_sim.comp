#version 440
layout (local_size_x = 64) in;
struct ParticleGPU // same
layout(std430, binding=0) buffer ParticlesBuf { ParticleGPU particles[]; };
layout(std430, binding=2) buffer AliveList { uint alive[]; };
layout(std430, binding=1) buffer AliveNew { uint aliveNew[]; };
layout(std430, binding=3) buffer DeadList { uint dead[]; };
layout(std430, binding=4) buffer Counters { uint aliveCount; uint newAliveCount; uint deadCount; };
layout(std430, binding=5) buffer Indirect { uint vertexCount; uint instanceCount; uint firstVertex; uint firstInstance; };
uniform float dt;
uniform vec3 gravity;
// curve arrays
void main() {
uint gid = gl_GlobalInvocationID.x;
if (gid >= aliveCount) return;
uint pidx = alive[gid];
ParticleGPU p = particles[pidx];
if (p.time < p.lifetime) {
p.time += dt;
float normt = p.time / p.lifetime;
p.vel[0] += gravity.x * dt;
p.vel[1] += gravity.y * dt;
p.vel[2] += gravity.z * dt;
p.pos[0] += p.vel[0] * dt;
p.pos[1] += p.vel[1] * dt;
p.pos[2] += p.vel[2] * dt;
p.size = sampleCurve(normt, sizeCurve, sizeCount); // define function
p.rotation += p.angularVelocity * dt;
p.frameTime += dt;
if (p.frameTime > 1.0 / fps) {
p.frame = mod(p.frame + 1.0, numFrames);
p.frameTime -= 1.0 / fps;
}
particles[pidx] = p;
uint aliveIdx = atomicAdd(newAliveCount, 1u);
aliveNew[aliveIdx] = pidx;
} else {
uint deadIdx = atomicAdd(deadCount, 1u);
dead[deadIdx] = pidx;
}
memoryBarrier(); // after all
if (gid == 0) {
vertexCount = 6;
instanceCount = newAliveCount;
firstVertex = 0;
firstInstance = 0;
}
}
particle.vs #version 430
// no in vertex, use gl_VertexID, gl_InstanceID
layout(std430, binding=0) buffer ParticlesBuf { ParticleGPU particles[]; };
layout(std430, binding=1) uniform AliveList { uint alive[]; }; // current
uniform mat4 mvp;
uniform vec3 viewPos;
uniform vec3 lightDir;
uniform vec4 lightColor;
uniform bool lit;
uniform int atlasCols;
uniform vec2 atlasSize = vec2(1,1);
uniform float fps;
uniform float numFrames;
out vec2 fragUV;
out vec4 fragColor;
out vec3 fragNormal;
const vec3 billboard[6] = vec3[6](vec3(-1,-1,0), vec3(1,-1,0), vec3(1,1,0), vec3(-1,-1,0), vec3(1,1,0), vec3(-1,1,0));
mat3 rotationMatrix(vec3 axis, float angle) {
axis = normalize(axis);
float s = sin(angle);
float c = cos(angle);
float oc = 1.0 - c;
return mat3(oc * axis.x * axis.x + c,           oc * axis.x * axis.y - axis.z * s,  oc * axis.z * axis.x + axis.y * s,
oc * axis.x * axis.y + axis.z * s,  oc * axis.y * axis.y + c,           oc * axis.y * axis.z - axis.x * s,
oc * axis.z * axis.x - axis.y * s,  oc * axis.y * axis.z + axis.x * s,  oc * axis.z * axis.z + c);
}
void main() {
uint pidx = alive[gl_InstanceID];
ParticleGPU p = particles[pidx];
vec3 pos = vec3(p.pos[0], p.pos[1], p.pos[2]);
vec3 camDir = normalize(pos - viewPos);
vec3 up = vec3(0,1,0);
if (abs(camDir.y) > 0.99) up = vec3(0,0,1);
vec3 right = normalize(cross(up, camDir));
up = cross(camDir, right);
mat3 rot = rotationMatrix(camDir, p.rotation);
vec3 corner = billboard[gl_VertexID % 6];
corner = rot * corner * p.size * 0.5;
pos += right * corner.x + up * corner.y;
gl_Position = mvp * vec4(pos, 1.0);
fragUV = (corner.xy + 1.0) * 0.5;
float frameX = mod(p.frame, atlasCols);
float frameY = floor(p.frame / atlasCols);
fragUV = fragUV * atlasSize + vec2(frameX, frameY) * atlasSize;
fragColor = vec4(p.color[0], p.color[1], p.color[2], p.color[3]);
if (lit) fragNormal = -camDir;
}