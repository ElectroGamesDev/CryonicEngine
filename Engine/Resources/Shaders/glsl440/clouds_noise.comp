#version 440
layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

// Output: 3-D noise volume (r = FBM shape, g = Worley detail)
layout(rg32f, binding = 0) uniform writeonly image3D noiseVolume;

// Uniforms
uniform vec2 wind;
uniform float time;
uniform float NOISE_SCALE;
uniform float WORLEY_SCALE;

// Noise helpers
vec3 mod289(vec3 x) { return x - floor(x * (1.0/289.0)) * 289.0; }
vec4 mod289(vec4 x) { return x - floor(x * (1.0/289.0)) * 289.0; }
vec4 permute(vec4 x){ return mod289(((x*34.0)+1.0)*x); }
vec4 taylorInvSqrt(vec4 r){ return 1.79284291400159 - 0.85373472095314 * r; }

float snoise(vec3 v) {
  const vec2 C = vec2(1.0/6.0, 1.0/3.0);
  const vec4 D = vec4(0.0, 0.5, 1.0, 2.0);
  vec3 i = floor(v + dot(v, C.yyy) );
  vec3 x0 = v - i + dot(i, C.xxx);
  vec3 g = step(x0.yzx, x0.xyz);
  vec3 l = 1.0 - g;
  vec3 i1 = min( g.xyz, l.zxy );
  vec3 i2 = max( g.xyz, l.zxy );
  vec3 x1 = x0 - i1 + C.xxx;
  vec3 x2 = x0 - i2 + C.yyy;
  vec3 x3 = x0 - D.yyy;
  i = mod289(i);
  vec4 p = permute( permute( permute(
               i.z + vec4(0.0, i1.z, i2.z, 1.0 ))
             + i.y + vec4(0.0, i1.y, i2.y, 1.0 ))
             + i.x + vec4(0.0, i1.x, i2.x, 1.0 ));
  vec4 j = p - 49.0 * floor(p / 49.0);
  vec4 x_ = floor(j / 7.0);
  vec4 y_ = floor(j - 7.0 * x_);
  vec4 x = (x_ * 2.0 + 0.5) / 7.0 - 0.5;
  vec4 y = (y_ * 2.0 + 0.5) / 7.0 - 0.5;
  vec4 h = 1.0 - abs(x) - abs(y);
  vec4 b0 = vec4( x.xy, y.xy );
  vec4 b1 = vec4( x.zw, y.zw );
  vec4 s0 = floor(b0)*2.0 + 1.0;
  vec4 s1 = floor(b1)*2.0 + 1.0;
  vec4 sh = -step(h, vec4(0.0));
  vec4 a0 = b0.xzyw + s0.xzyw*sh.xxyw ;
  vec4 a1 = b1.xzyw + s1.xzyw*sh.zzzw ;
  vec3 p0 = vec3(a0.xy,h.x);
  vec3 p1 = vec3(a0.zw,h.y);
  vec3 p2 = vec3(a1.xy,h.z);
  vec3 p3 = vec3(a1.zw,h.w);
  vec4 norm = taylorInvSqrt(vec4(dot(p0,p0), dot(p1,p1), dot(p2, p2), dot(p3,p3)));
  p0 *= norm.x; p1 *= norm.y; p2 *= norm.z; p3 *= norm.w;
  vec4 m = max(0.6 - vec4(dot(x,x), dot(x,y), dot(y,y), dot(y,y) ), 0.0);
  m = m * m;
  return 42.0 * dot( m*m, vec4( dot(p0,x0), dot(p1,x1),
                                dot(p2,x2), dot(p3,x3) ) );
}

float fbm(vec3 p, float t){
    float v = 0.0, a = 0.5, f = 1.0;
    mat3 rot = mat3(cos(t*0.1),-sin(t*0.1),0.0,
                    sin(t*0.1), cos(t*0.1),0.0,
                    0.0,0.0,1.0);
    for(int i=0;i<6;i++){
        v += a * (snoise(p*f) * 0.5 + 0.5);
        p = rot * p * 2.0;
        a *= 0.5; f *= 2.0;
    }
    return v;
}

vec3 hash3(vec3 p){
    p = fract(p*vec3(0.1031,0.1030,0.0973));
    p += dot(p,p.yxz+33.33);
    return fract((p.xxy + p.yxx)*p.zyx);
}

float worley(vec3 p){
    vec3 pi = floor(p);
    float d = 1e10;
    for(int z=-1;z<=1;++z)for(int y=-1;y<=1;++y)for(int x=-1;x<=1;++x){
        vec3 off = vec3(x,y,z);
        vec3 pt  = hash3(pi+off);
        d = min(d,length(pt+off-(p-pi)));
    }
    return smoothstep(0.0,0.8,clamp(d/1.732,0.0,1.0));
}

void main(){
    ivec3 coord = ivec3(gl_GlobalInvocationID);

    // world position of this voxel
    const float VOL_SIZE = 64.0;
    vec3 world = (vec3(coord) - VOL_SIZE*0.5) * (8000.0 / VOL_SIZE); // cast to vec3

    // wind
    world += vec3(wind.x, 0.0, wind.y) * time * 0.005;

    float base = fbm(world*NOISE_SCALE,time*0.05);
    base = smoothstep(0.35,0.7,base);

    float detail = worley(world*WORLEY_SCALE + vec3(time*0.02));
    detail = 1.0 - detail; // mix(1.0,detail,0.4);

    imageStore(noiseVolume,coord,vec4(base,detail,0.0,1.0));
}